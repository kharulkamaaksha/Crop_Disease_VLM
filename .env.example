# Copy this file to `.env` and edit the values for your machine:
#   cp .env.example .env
#
# Environment variables (and this file) always take precedence over the
# defaults hardcoded in config.py, so the same code runs unmodified on
# Windows, macOS, and Linux.

# ── Model paths ───────────────────────────────────────────────────────────
# Path to YOUR fine-tuned LoRA adapter (output of training on PlantVillage).
# Not included in this repo — the weights are too large for git. Point this
# at wherever you saved your checkpoint.
VLM_ADAPTER_PATH=./checkpoints/qwen25vl_plantvillage_best

# Base VLM — a Hugging Face model ID (downloaded automatically on first run)
# or a local path. Usually fine to leave as-is.
VLM_BASE_MODEL_PATH=Qwen/Qwen2.5-VL-7B-Instruct

# CLIP model used for out-of-distribution (OOD) leaf detection.
VLM_CLIP_MODEL_PATH=openai/clip-vit-base-patch32

# ── Compute ───────────────────────────────────────────────────────────────
# auto | cuda | mps | cpu   ("auto" picks CUDA > Apple Silicon MPS > CPU)
VLM_DEVICE=auto

# ── Pipeline tuning (optional — safe to leave commented out) ──────────────
# VLM_OOD_THRESHOLD=0.27
# VLM_MAX_NEW_TOKENS=200
# VLM_NUM_BEAMS=4
# VLM_REPETITION_PENALTY=2.5
# VLM_NO_REPEAT_NGRAM_SIZE=6
# VLM_CONFIDENCE_OFFSET=0.30

# ── Logging ─────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
# VLM_LOG_LEVEL=INFO
